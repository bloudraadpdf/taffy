<test name="width_smaller_then_content_with_flex_grow_unconstraint_size__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr">
      <div box-sizing="content-box" direction="ltr" flex-direction="column" flex-grow="1" width="0px">
        <div box-sizing="content-box" direction="ltr" width="70px" height="100px"/>
      </div>
      <div box-sizing="content-box" direction="ltr" flex-direction="column" flex-grow="1" width="0px">
        <div box-sizing="content-box" direction="ltr" width="20px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <!-- CSS Flexbox 9.9.3: the content size of an item is the floor of its contribution. Chromium gives width 0. -->
    <node x="0" y="0" width="90" height="100">
      <node x="0" y="0" width="45" height="100">
        <node x="0" y="0" width="70" height="100"/>
      </node>
      <node x="45" y="0" width="45" height="100">
        <node x="0" y="0" width="20" height="100"/>
      </node>
    </node>
  </expectations>
</test>
